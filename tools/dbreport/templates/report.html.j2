<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Rapport standard du parc Oracle</title>
<style>
  *{box-sizing:border-box}
  :root{
    --bg:#eef1f6;--surface:#fff;--ink:#0f172a;--muted:#64748b;--line:#e2e8f0;
    --primary:#2563eb;--ok:#16a34a;--warn:#d97706;--err:#dc2626;--radius:14px;
    --shadow:0 1px 2px rgba(15,23,42,.06),0 10px 26px -14px rgba(15,23,42,.35);
  }
  body{margin:0;background:var(--bg);color:var(--ink);
    font:15px/1.5 "Segoe UI",Roboto,Helvetica,Arial,sans-serif}
  .topbar{position:sticky;top:0;z-index:20;color:#fff;padding:18px 28px;
    background:linear-gradient(135deg,#0f172a,#1e293b);box-shadow:var(--shadow)}
  .topbar h1{margin:0 0 4px;font-size:1.35rem;letter-spacing:.2px}
  .topbar .meta{color:#cbd5e1;font-size:.85rem}
  .wrap{max-width:1420px;margin:0 auto;padding:20px 28px 64px}
  .kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;margin:18px 0}
  .kpi{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);
    padding:13px 16px;box-shadow:var(--shadow)}
  .kpi .k{color:var(--muted);font-size:.72rem;text-transform:uppercase;letter-spacing:.06em}
  .kpi .v{font-size:1.5rem;font-weight:700;margin-top:4px}
  .kpi .v.ok{color:var(--ok)}.kpi .v.warn{color:var(--warn)}.kpi .v.err{color:var(--err)}
  .toolbar{display:flex;flex-wrap:wrap;gap:10px;align-items:center;margin:8px 0 12px}
  .toolbar input[type=search]{flex:1 1 280px;min-width:200px;padding:10px 14px;border-radius:10px;
    border:1px solid var(--line);background:#fff;font-size:.95rem;outline:none}
  .toolbar input[type=search]:focus{border-color:var(--primary);box-shadow:0 0 0 3px rgba(37,99,235,.15)}
  .tabs{display:flex;gap:8px;overflow-x:auto;padding:6px 0;scrollbar-width:thin}
  .tab{flex:0 0 auto;border:1px solid var(--line);background:#fff;color:var(--ink);
    padding:8px 14px;border-radius:999px;cursor:pointer;font-size:.85rem;display:flex;
    align-items:center;gap:8px;white-space:nowrap;transition:.15s}
  .tab:hover{border-color:var(--primary)}
  .tab.active{background:var(--primary);border-color:var(--primary);color:#fff;font-weight:600}
  .tab .dot{width:8px;height:8px;border-radius:50%;display:inline-block}
  .tab .dot.ok{background:var(--ok)}.tab .dot.err{background:var(--err)}
  .panel{display:none;animation:fade .18s ease}
  .panel.active{display:block}
  @keyframes fade{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:none}}
  .card{background:var(--surface);border:1px solid var(--line);border-radius:var(--radius);
    box-shadow:var(--shadow);padding:18px 20px;margin:16px 0}
  .dbhead{display:flex;flex-wrap:wrap;align-items:center;gap:12px}
  h2.dbname{margin:0;font-size:1.25rem}
  .badge{font-size:.72rem;padding:3px 10px;border-radius:999px;color:#fff;font-weight:600}
  .badge.ok{background:var(--ok)}.badge.partiel{background:var(--warn)}
  .badge.non_disponible,.badge.erreur{background:var(--err)}
  table{width:100%;border-collapse:collapse;margin:8px 0 4px;font-size:.85rem}
  th,td{border:1px solid var(--line);padding:6px 9px;text-align:left;vertical-align:top}
  thead th{background:#f8fafc;color:#334155;position:sticky;top:0;font-weight:600}
  tbody tr:nth-child(even){background:#fbfcfe}
  .tablewrap{overflow:auto;border-radius:10px;border:1px solid var(--line);max-height:440px}
  .facts{display:grid;grid-template-columns:minmax(150px,auto) 1fr;gap:4px 16px;margin:6px 0}
  .facts dt{color:var(--muted)}.facts dd{margin:0;font-weight:600}
  .section{margin-top:18px;padding-top:14px;border-top:1px dashed var(--line)}
  .section h4{margin:0 0 8px;font-size:.92rem;text-transform:uppercase;letter-spacing:.05em;
    color:#475569;display:flex;gap:8px;align-items:center}
  .muted{color:var(--muted)}
  .err-text{color:var(--err);font-weight:600}
  details.msg{margin-top:8px}details.msg summary{cursor:pointer;color:#475569}
  .summary-table tr[data-goto]{cursor:pointer}
  .summary-table tr[data-goto]:hover{background:#eff6ff}
  label.chk{display:flex;align-items:center;gap:6px;font-size:.85rem;color:var(--muted)}
  @media(max-width:640px){.wrap{padding:14px}.topbar{padding:16px}}
</style>
</head>
<body>
<header class="topbar">
  <h1>Rapport standard du parc Oracle</h1>
  <div class="meta">Généré le {{ meta.generated_at }} · {{ kpis.bases }} base(s) · Inventaire : {{ meta.inventory }}</div>
</header>
<div class="wrap">

  <div class="kpis">
    <div class="kpi"><div class="k">Bases</div><div class="v">{{ kpis.bases }}</div></div>
    <div class="kpi"><div class="k">Collectes OK</div><div class="v ok">{{ kpis.ok }}</div></div>
    <div class="kpi"><div class="k">En erreur</div><div class="v {{ 'err' if kpis.errors else 'ok' }}">{{ kpis.errors }}</div></div>
    <div class="kpi"><div class="k">Taille totale (Go)</div><div class="v">{{ kpis.total_gb }}</div></div>
    <div class="kpi"><div class="k">Tablespace max</div><div class="v {{ 'err' if kpis.max_tablespace_pct >= 90 else ('warn' if kpis.max_tablespace_pct >= 80 else '') }}">{{ kpis.max_tablespace_pct }} %</div></div>
    <div class="kpi"><div class="k">Objets invalides</div><div class="v {{ 'warn' if kpis.invalid_total else '' }}">{{ kpis.invalid_total }}</div></div>
    <div class="kpi"><div class="k">Comptes verrouillés</div><div class="v {{ 'warn' if kpis.locked_total else '' }}">{{ kpis.locked_total }}</div></div>
    <div class="kpi"><div class="k">Sauvegarde + ancienne</div><div class="v {{ 'warn' if (kpis.oldest_backup_days is not none and kpis.oldest_backup_days >= 7) else '' }}">{{ kpis.oldest_backup_days if kpis.oldest_backup_days is not none else '—' }} j</div></div>
    <div class="kpi"><div class="k">Standby DG</div><div class="v">{{ kpis.dg_standby_total }}</div></div>
    <div class="kpi"><div class="k">Synchronisés</div><div class="v ok">{{ kpis.dg_synced_total }}</div></div>
    <div class="kpi"><div class="k">Avec GAP</div><div class="v {{ 'err' if kpis.dg_gap_total else 'ok' }}">{{ kpis.dg_gap_total }}</div></div>
  </div>

  <div class="toolbar">
    <input id="filter" type="search" placeholder="Rechercher une base (nom, environnement)…">
    <button class="tab active" type="button" data-target="overview" data-name="">Synthèse</button>
    <span class="muted" id="count"></span>
  </div>

  <nav class="tabs" id="tabs">
    {% for tab in tabs %}
    <button class="tab" type="button" data-target="{{ tab.id }}" data-name="{{ (tab.name ~ ' ' ~ (tab.environment or ''))|lower }}">
      {{ tab.name }}<span class="dot {{ 'ok' if tab.ok else 'err' }}"></span>
    </button>
    {% endfor %}
  </nav>

  <section id="overview" class="panel active">
    <div class="card">
      <h2>Synthèse du parc</h2>
      {% if summary %}
      <div class="tablewrap">
        <table class="summary-table">
          <thead><tr>{% for col in summary[0].keys() %}<th>{{ col }}</th>{% endfor %}</tr></thead>
          <tbody>
            {% for row in summary %}
            <tr data-goto="db-{{ loop.index0 }}">{% for value in row.values() %}<td>{{ value if value is not none else '' }}</td>{% endfor %}</tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      <p class="muted">Astuce : cliquez une ligne pour ouvrir le détail de la base correspondante.</p>
      {% else %}
      <p class="muted">Aucune base dans l'inventaire.</p>
      {% endif %}
    </div>
  </section>
  {% for snap in snapshots %}
  <section id="db-{{ loop.index0 }}" class="panel">
    <div class="card">
      <div class="dbhead">
        <h2 class="dbname">{{ snap.name }}</h2>
        <span class="badge {{ 'ok' if snap.ok else 'erreur' }}">{{ 'OK' if snap.ok else 'ERREUR' }}</span>
      </div>
      <p class="muted">Env : {{ snap.environment or '—' }} · Service : {{ snap.service or '—' }} · DSN : {{ snap.dsn }} · Collecté : {{ snap.collected_at }}</p>
      {% if not snap.ok %}<p class="err-text">Erreur de collecte : {{ snap.error }}</p>{% endif %}

      {% for section in snap.sections %}
      <div class="section">
        <h4>{{ section.section }} <span class="badge {{ section.status|lower }}">{{ section.status }}</span></h4>
        {% if section.facts %}
        <dl class="facts">
          {% for key, value in section.facts.items() %}
          <dt>{{ key }}</dt><dd>{{ value if value is not none else '—' }}</dd>
          {% endfor %}
        </dl>
        {% endif %}
        {% for table, rows in section.tables.items() %}
          <p class="muted" style="margin:10px 0 2px"><strong>{{ table }}</strong></p>
          {% if rows %}
          <div class="tablewrap">
            <table>
              <thead><tr>{% for col in rows[0].keys() %}<th>{{ col }}</th>{% endfor %}</tr></thead>
              <tbody>
                {% for row in rows %}
                <tr>{% for col in rows[0].keys() %}<td>{{ row.get(col) if row.get(col) is not none else '' }}</td>{% endfor %}</tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
          {% else %}
          <p class="muted">Aucune ligne.</p>
          {% endif %}
        {% endfor %}
        {% if section.messages %}
        <details class="msg">
          <summary>Messages / avertissements ({{ section.messages|length }})</summary>
          <ul>{% for message in section.messages %}<li>{{ message }}</li>{% endfor %}</ul>
        </details>
        {% endif %}
      </div>
      {% endfor %}
    </div>
  </section>
  {% endfor %}
</div>

<script>
(function () {
  var PANEL_CLASS = 'active';
  var panels = Array.prototype.slice.call(document.querySelectorAll('.panel'));
  var tabs = Array.prototype.slice.call(document.querySelectorAll('.tab[data-target]'));
  var count = document.getElementById('count');
  var total = tabs.filter(function (t) { return t.dataset.target !== 'overview'; }).length;

  function activate(id) {
    panels.forEach(function (p) { p.classList.toggle(PANEL_CLASS, p.id === id); });
    tabs.forEach(function (t) { t.classList.toggle(PANEL_CLASS, t.dataset.target === id); });
    var active = tabs.filter(function (t) { return t.dataset.target === id; })[0];
    if (active) { active.scrollIntoView({ block: 'nearest', inline: 'center' }); }
    try { history.replaceState(null, '', '#' + id); } catch (e) { /* file:// */ }
  }

  tabs.forEach(function (t) {
    t.addEventListener('click', function () { activate(t.dataset.target); });
  });
  document.querySelectorAll('.summary-table tr[data-goto]').forEach(function (row) {
    row.addEventListener('click', function () { activate(row.dataset.goto); });
  });

  var filter = document.getElementById('filter');
  if (filter) {
    filter.addEventListener('input', function () {
      var q = filter.value.trim().toLowerCase();
      var shown = 0;
      tabs.forEach(function (t) {
        if (t.dataset.target === 'overview') { return; }
        var match = !q || (t.dataset.name || '').indexOf(q) !== -1;
        t.style.display = match ? '' : 'none';
        if (match) { shown += 1; }
      });
      if (count) { count.textContent = q ? (shown + ' / ' + total + ' base(s)') : ''; }
    });
  }

  var hash = location.hash.replace('#', '');
  if (hash && document.getElementById(hash)) { activate(hash); }
})();
</script>
</body>
</html>

