# ============================================================================
# dbreport - configuration de l'outillage de rapport des bases Oracle
#
# Copier ce fichier en `.env` puis renseigner les mots de passe :
#     cp .env.example .env
#
# L'outil lit ce fichier automatiquement (setup_project.py), sans jamais
# ecraser une variable deja presente dans l'environnement du shell.
# ============================================================================

# --- Inventaire du parc ------------------------------------------------------
# Chemin du fichier decrivant les bases a auditer (relatif a la racine projet).
ORAREPORT_INVENTORY=databases.yaml

# --- Sorties -----------------------------------------------------------------
# Repertoire racine des snapshots et rapports (relatif a la racine projet).
ORAREPORT_OUTPUT_DIR=output
# Nom du fichier de snapshot ecrit dans chaque dossier horodate.
ORAREPORT_SNAPSHOT_NAME=snapshot.json

# --- Options de collecte -----------------------------------------------------
# Delai maximal (secondes) accorde a chaque appel serveur / requete.
ORAREPORT_CALL_TIMEOUT=60
# Sections activees par defaut (liste separee par des virgules). Vide = toutes.
# Sections disponibles : identity, capacity, objects, health, security, backup
ORAREPORT_SECTIONS=

# --- Options de l'outillage --------------------------------------------------
# ORAREPORT_ENV_FILE=.env
# ORAREPORT_VENV=.venv
# ORAREPORT_LOG_FILE=.dbreport/dbreport.log

# --- Mots de passe des bases de collecte -------------------------------------
# Recommande : ne pas ecrire les mots de passe dans databases.yaml mais ici.
# La variable est ORAREPORT_<NOM_DE_LA_BASE>_PASSWORD (nom mis en majuscules).
#
# ORAREPORT_ORCL_PROD_PASSWORD=change_me
# ORAREPORT_ORCL_PROD_STBY_PASSWORD=change_me
